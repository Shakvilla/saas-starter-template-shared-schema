						"url": {
							"raw": "{{baseUrl}}/api/v1/users",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "users"]
						},
						"description": "List all users in the tenant. **Requires admin permissions.**"
					}
				},
				{
					"name": "Get User by ID",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{userToken}}"}]
						},
						"method": "GET",
						"header": [
							{
								"key": "X-Tenant-ID",
								"value": "{{tenantId}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/users/{{userId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "users", "{{userId}}"]
						},
						"description": "Get a specific user by ID. **Requires admin permissions.**"
					}
				},
				{
					"name": "Update User",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{userToken}}"}]
						},
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-Tenant-ID",
								"value": "{{tenantId}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"fullName\": \"Updated Name\",\n    \"companyName\": \"Updated Company\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/users/{{userId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "users", "{{userId}}"]
						},
						"description": "Update a user's profile. **Requires admin permissions.**"
					}
				},
				{
					"name": "Deactivate User",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{userToken}}"}]
						},
						"method": "DELETE",
						"header": [
							{
								"key": "X-Tenant-ID",
								"value": "{{tenantId}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/users/{{userId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "users", "{{userId}}"]
						},
						"description": "Deactivate a user. **Requires admin permissions.**"
					}
				}
			]
		},
